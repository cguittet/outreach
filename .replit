entrypoint = "apps/web/server/index.ts"
run = "pnpm dev"
modules = ["nodejs-20", "web", "postgresql-16"]

[deployment]
build = "pnpm build:web"
run = "pnpm start"
deploymentTarget = "autoscale"

[gitHubImport]
requiredFiles = [".replit", "package.json", "pnpm-lock.yaml"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]

[userenv.development]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm install && pnpm db:migrate && pnpm dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 24678
externalPort = 80

[agent]
