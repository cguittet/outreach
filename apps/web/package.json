{
  "name": "@trucea/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build && tsup --config tsup.server.config.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.73",
    "@clerk/react": "^6.17.3",
    "@clerk/shared": "^4.37.0",
    "@clerk/themes": "^2.4.57",
    "@trucea/shared": "workspace:*",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^1.48.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.4.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
