{
  "name": "@trucea/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "vite build && tsup --config tsup.server.config.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts"
  },
  "dependencies": {
    "@trucea/shared": "workspace:*",
    "@vitejs/plugin-react": "^6.0.5",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "express-session": "^1.18.1",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.1",
    "openid-client": "^6.5.0",
    "passport": "^0.7.0",
    "pg": "^8.15.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.2.0",
    "vite": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.11.14",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "tsup": "^8.4.0",
    "vitest": "^4.1.10"
  }
}
