{
  "manifest_version": 3,
  "name": "Trucea Outreach Companion",
  "description": "Add LinkedIn prospects and keep follow-ups moving without scraping or automated sending.",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage", "alarms", "notifications", "clipboardWrite"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Trucea Outreach" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
